#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct main0_out
{
    float2 var_uv [[user(locn0)]];
    float4 gl_Position [[position]];
};

vertex main0_out main0(uint gl_VertexIndex [[vertex_id]])
{
    main0_out out = {};
    float x = float((int(gl_VertexIndex) << 1) & 2);
    float y = float(int(gl_VertexIndex) & 2);
    out.var_uv = float2(x, y);
    out.gl_Position = float4((x * 2.0) - 1.0, (y * 2.0) - 1.0, 0.0, 1.0);
    return out;
}

